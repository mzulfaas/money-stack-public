# ==============================================================================
# money-stack-public — Environment Configuration
# ==============================================================================
# 1. Create a Tebar.app account & API key via: https://tebar.app/?ref=BLASTER
# 2. Copy this file to .env and fill in your credentials.
# 3. NEVER commit .env or config/accounts.json.
# ==============================================================================

# --- Primary Social Scheduler (Tebar.app) ---
# Sign up / manage workspaces at https://tebar.app/?ref=BLASTER
TEBAR_API_KEY=your_tebar_api_key_here
TEBAR_BASE_URL=https://api.tebar.app/v1

# --- Optional Config & Data Paths ---
# MONEY_STACK_CONFIG_DIR=./config
# MONEY_STACK_DATA_DIR=./data
# MONEY_STACK_TZ_OFFSET_HOURS=7

# --- Optional AI / Media Providers (for UGC extensions) ---
# GEMINI_API_KEY=your_gemini_api_key_here
